<view class="container">
  <view class="header">
    <view class="title">我的</view>
  </view>

  <!-- R-JobPilot-v2 W3 fix: 登录入口 (IDE 模拟器跳过自动登录) -->
  <view class="section">
    <view wx:if="{{!isLoggedIn}}" class="row login-row" bindtap="onLogin">
      <text class="login-text">🔑 点击登录 (聊天需要 token)</text>
      <text class="arrow">›</text>
    </view>
    <view wx:else class="row">
      <text>✅ 已登录 (openid: {{openidTail}})</text>
      <text class="logout-text" bindtap="onLogout">退出</text>
    </view>
  </view>

  <view class="section">
    <view class="row" bindtap="onAbout">
      <text>关于简历助手</text>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="onPrivacy">
      <text>隐私协议</text>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="onTerms">
      <text>服务条款</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section admin-only" wx:if="{{isAdmin}}">
    <view class="row admin-row" bindtap="onAdminDashboard">
      <text class="admin-text">📊 数据大屏</text>
      <text class="arrow">›</text>
    </view>
    <view class="row admin-row" bindtap="onAdminJobs">
      <text class="admin-text">⚙ 岗位管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="row admin-row" bindtap="onAdminPrompts">
      <text class="admin-text">⚙ 提示词管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="row admin-row" bindtap="onAdminLogs">
      <text class="admin-text">⚙ 操作日志</text>
      <text class="arrow">›</text>
    </view>
    <view class="row admin-row" bindtap="onAdminLegal">
      <text class="admin-text">⚖ 法务文档版本</text>
      <text class="arrow">›</text>
    </view>
    <view class="row admin-row" bindtap="onAdminAdmins">
      <text class="admin-text">⚙ Admin 用户管理</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
