/* R131: 首页行业卡片精致版 (跟全局 theme 统一) */

.container {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Hero 卡片 (顶部标题, 渐变紫) */
.hero-card {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(99,102,241,0.25);
  animation: heroIn 0.5s ease-out;
}

@keyframes heroIn {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.92);
  line-height: 1.6;
}

/* 行业卡片列表 */
.industries-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.industry-card {
  background: #ffffff;
  border: 1rpx solid #e5e5e7;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s, box-shadow 0.2s, border-color 0.2s;
  animation: cardIn 0.4s ease-out backwards;
}

/* 错位入场动画 (stagger) */
.industry-card:nth-child(1) { animation-delay: 0.05s; }
.industry-card:nth-child(2) { animation-delay: 0.10s; }
.industry-card:nth-child(3) { animation-delay: 0.15s; }
.industry-card:nth-child(4) { animation-delay: 0.20s; }
.industry-card:nth-child(5) { animation-delay: 0.25s; }
.industry-card:nth-child(6) { animation-delay: 0.30s; }

@keyframes cardIn {
  from { opacity: 0; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.industry-card:active {
  transform: scale(0.98);
  background: #f9f9fb;
  border-color: #6366f1;
  box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.12);
}

.industry-card.hot {
  border-color: rgba(255,149,0,0.3);
  background: linear-gradient(135deg, #ffffff 0%, #fffbeb 100%);
}

.industry-left {
  flex: 1;
  min-width: 0;
}

.industry-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.industry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  flex-shrink: 0;
}

/* 🔥 近期较好徽章 */
.hot-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff9500 0%, #ff6b00 100%);
  border-radius: 999rpx;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(255,149,0,0.3);
  animation: hotPulse 2s ease-in-out infinite;
}

@keyframes hotPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.hot-badge-text {
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
}

.industry-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.stat-item {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 右侧箭头 */
.industry-arrow {
  font-size: 36rpx;
  color: #c7c7cc;
  font-weight: 300;
  margin-left: 16rpx;
  transition: transform 0.2s, color 0.2s;
}

.industry-card:active .industry-arrow {
  color: #6366f1;
  transform: translateX(4rpx);
}

/* Loading / Empty */
.loading {
  text-align: center;
  padding: 48rpx 0;
  color: #8e8e93;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #8e8e93;
  font-size: 26rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

/* 底部预览按钮 */
.preview-btn {
  margin-top: 32rpx;
  padding: 20rpx;
  text-align: center;
  background: transparent;
  border: 1rpx solid #e5e5e7;
  border-radius: 12rpx;
  color: #6366f1;
  font-size: 26rpx;
  transition: background 0.2s;
}

.preview-btn:active {
  background: #f2f2f7;
}