/* BigScreen — 跟 jobpilot/index 5 步法视觉 100% 一致
 * R128 (2026-07-31):
 *   v1 (旧): 抖音黑底紫渐变
 *   v3 (current): Apple HIG + 紫色 #6366f1, 跟 jobpilot/index 完全一致
 *
 * 共享 token (from jobpilot/index.wxss):
 *   - bg: #f5f5f7 (Apple light gray)
 *   - surface: #fff
 *   - border: #e5e5e7
 *   - primary: #6366f1 (indigo)
 *   - success: #1f7a1f (Apple green)
 *   - warning: #ff9500 (Apple orange)
 *   - text-primary: #1c1c1e
 *   - text-secondary: #3a3a3c
 *   - text-muted: #8e8e93
 *   - error-bg: #fee2e2, error-text: #991b1b
 *   - radius: 12-16rpx (Apple standard)
 */

/* ─── 主页面 ───────────────────────── */
.feed-page {
  width: 100%;
  min-height: 100vh;
  background: #f5f5f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  overflow-x: hidden;
}

.feed-scroll {
  width: 100%;
  min-height: 100vh;
}

/* ─── 顶部 progress bar (跟 jobpilot.progress-bar 一致) ───────────────────────── */
.feed-progress {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.feed-dot {
  flex: 1;
  height: 8rpx;
  background: #e5e5e7;
  margin: 0 2rpx;
  transition: all 0.3s;
}

.feed-dot.active {
  background: #6366f1;
}

.feed-dot.done {
  background: #1f7a1f;
}

.feed-progress-num {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
  padding: 12rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #e5e5e7;
}

/* ─── 5 星座 section (跟 jobpilot.step-content 风格) ───────────────────────── */
.feed-section {
  min-height: 70vh;
  padding: 40rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  position: relative;
}

.feed-section-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
}

.feed-section-desc {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
}

/* ─── AI 头像 (紫色) ───────────────────────── */
.feed-ai-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #6366f1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  position: absolute;
  top: 32rpx;
  right: 32rpx;
}

/* ─── 字段卡 (跟 jobpilot .match-card 同风格) ───────────────────────── */
.feed-fields {
  width: 100%;
  white-space: nowrap;
  margin-top: 16rpx;
}

.feed-field-card {
  display: inline-block;
  width: 300rpx;
  height: 180rpx;
  margin-right: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  vertical-align: top;
  white-space: normal;
  overflow: hidden;
  transition: all 0.2s;
}

.feed-field-card.filled {
  background: #f0f9f4;
  border-color: #1f7a1f;
}

.feed-field-card.current {
  background: #fff;
  border-color: #6366f1;
  border-width: 2rpx;
}

.feed-field-card.done {
  opacity: 0.6;
}

.feed-field-label {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.feed-field-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  word-break: break-all;
}

.feed-field-prompt {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #6366f1;
  text-align: center;
  line-height: 80rpx;
}

/* ─── 底部 footer ───────────────────────── */
.feed-footer {
  padding: 48rpx 0 180rpx;
  text-align: center;
}

.feed-footer-text {
  font-size: 26rpx;
  color: #8e8e93;
}

/* ─── 底部 fixed input bar (跟 jobpilot .btn-primary 风格) ───────────────────────── */
.feed-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #e5e5e7;
  z-index: 20;
}

.feed-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f2f2f7;
  border-radius: 12rpx;
  color: #1c1c1e;
  font-size: 28rpx;
  border: 1rpx solid transparent;
  transition: border-color 0.2s;
}

.feed-input:focus {
  border-color: #6366f1;
  background: #fff;
}

.feed-send-btn {
  padding: 16rpx 28rpx;
  background: #6366f1;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ─── 简历预览卡 (跟 jobpilot .match-card 同风格) ───────────────────────── */
.feed-preview-card {
  position: fixed;
  right: 24rpx;
  bottom: 140rpx;
  width: 420rpx;
  max-height: 400rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  z-index: 50;
  overflow: hidden;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #e5e5e7;
}

.preview-title {
  font-size: 24rpx;
  color: #1c1c1e;
  font-weight: 600;
}

.copy-md-btn {
  padding: 4rpx 12rpx;
  background: #f2f2f7;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #6366f1;
  font-weight: 500;
}

.preview-md-scroll {
  max-height: 320rpx;
  padding: 12rpx 16rpx;
}

.preview-md {
  font-size: 22rpx;
  color: #3a3a3c;
  line-height: 1.6;
  white-space: pre-wrap;
  font-family: monospace;
}

/* ─── 雷达图 (跟 jobpilot .match-card 同风格) ───────────────────────── */
.feed-radar {
  position: fixed;
  left: 24rpx;
  bottom: 140rpx;
  width: 300rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  border-radius: 16rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 50;
}

.radar-title {
  display: block;
  font-size: 22rpx;
  color: #1c1c1e;
  font-weight: 600;
  margin-bottom: 8rpx;
  text-align: center;
}

.radar-canvas {
  width: 100%;
  height: 200rpx;
}

.radar-labels {
  display: flex;
  justify-content: space-around;
  margin-top: 8rpx;
}

.radar-axis-label {
  font-size: 18rpx;
  color: #8e8e93;
}

/* ─── Modal 弹窗 (跟 jobpilot .modal-card 同风格) ───────────────────────── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.12);
}

.modal-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 20rpx;
}

.modal-input {
  width: 100%;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  border-radius: 12rpx;
  color: #1c1c1e;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  transition: border-color 0.2s;
}

.modal-input:focus {
  border-color: #6366f1;
}

.modal-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.modal-chip {
  padding: 16rpx 28rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #1c1c1e;
  transition: all 0.2s;
}

.modal-chip.active {
  background: #6366f1;
  color: #fff;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-cancel {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #f2f2f7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1c1c1e;
}

.modal-save {
  flex: 2;
  padding: 20rpx;
  text-align: center;
  background: #6366f1;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

/* ─── AI 多轮对话 ───────────────────────── */
.ai-chat-history {
  max-height: 240rpx;
  margin-bottom: 20rpx;
  padding: 12rpx;
  background: #f9f9fb;
  border-radius: 12rpx;
}

.ai-msg {
  display: flex;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.ai-msg--user {
  flex-direction: row-reverse;
}

.ai-msg-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
  background: #6366f1;
}

.ai-msg-text {
  max-width: 75%;
  padding: 10rpx 14rpx;
  background: #f2f2f7;
  border-radius: 12rpx;
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 1.4;
}

.ai-msg--user .ai-msg-text {
  background: #6366f1;
  color: #fff;
}

.ai-followup {
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  background: #f9f9fb;
  border-left: 6rpx solid #6366f1;
  border-radius: 8rpx;
}

.ai-followup-text {
  font-size: 26rpx;
  color: #1c1c1e;
  line-height: 1.4;
}

.ai-suggestion-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 20rpx;
  background: #f2f2f7;
  border: 1rpx solid #6366f1;
  border-radius: 12rpx;
}

.ai-suggestion-icon {
  font-size: 28rpx;
}

.ai-suggestion-text {
  flex: 1;
  font-size: 26rpx;
  color: #1c1c1e;
  line-height: 1.4;
}

.ai-error {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  background: #fee2e2;
  border-radius: 12rpx;
}

.ai-error-text {
  flex: 1;
  font-size: 24rpx;
  color: #991b1b;
  line-height: 1.4;
}

.ai-error-retry {
  padding: 6rpx 16rpx;
  background: #fecaca;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #991b1b;
}

/* ─── Wizard 模式 (跟 jobpilot 一致) ───────────────────────── */
.wizard-progress {
  margin-bottom: 20rpx;
}

.wizard-progress-text {
  font-size: 22rpx;
  color: #8e8e93;
  text-align: right;
  margin-bottom: 8rpx;
}

.wizard-progress-bar {
  height: 8rpx;
  background: #e5e5e7;
  border-radius: 4rpx;
  overflow: hidden;
}

.wizard-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1 0%, #1f7a1f 100%);
  transition: width 0.3s;
}

.wizard-question {
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #f9f9fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wizard-question-label {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}

.wizard-question-text {
  font-size: 28rpx;
  color: #1c1c1e;
  line-height: 1.5;
  font-weight: 500;
}

.wizard-hint {
  font-size: 24rpx;
  color: #8e8e93;
  font-style: italic;
}

.wizard-next-btn {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #6366f1;
  border-radius: 12rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.wizard-cancel-btn {
  margin-top: 16rpx;
  padding: 12rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

/* ─── Tinder 卡 (跟 jobpilot .match-card 同结构) ───────────────────────── */
/* R128: tinder-card 改小 + 横排, 不挡 input 视野 */
.tinder-card {
  margin: 16rpx 0;
  padding: 16rpx 20rpx;
  background: #f9f9fb;
  border: 2rpx solid #6366f1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  max-height: 120rpx;
  justify-content: flex-start;
}

.tinder-card-counter {
  font-size: 22rpx;
  color: #8e8e93;
}

.tinder-card-reason {
  font-size: 26rpx;
  color: #3a3a3c;
  text-align: center;
}

.tinder-card-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #6366f1;
  text-align: center;
  line-height: 1.3;
}

.tinder-actions {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin: 16rpx 0;
}

.tinder-btn {
  flex: 1;
  padding: 20rpx 8rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1c1c1e;
  background: #f2f2f7;
  transition: transform 0.15s;
}

.tinder-btn:active {
  transform: scale(0.95);
}

.tinder-btn--left {
  background: #fee2e2;
  color: #991b1b;
}

.tinder-btn--right {
  background: #d1f4d1;
  color: #1f7a1f;
}

.tinder-btn--up {
  background: #fef3c7;
  color: #92400e;
}

.tinder-question {
  padding: 16rpx;
  margin: 16rpx 0;
  text-align: center;
}

.tinder-question-text {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 500;
  line-height: 1.4;
}

.tinder-hint {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 8rpx;
}

.tinder-input {
  margin: 16rpx 0;
}

.tinder-next-btn {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #6366f1;
  border-radius: 12rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ─── 动效 ───────────────────────── */
@keyframes avatar-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
.feed-ai-avatar { animation: avatar-breathe 3s ease-in-out infinite; }

.feed-progress-bar .feed-progress-fill { transition: width 0.6s ease-out; }

@keyframes explode-particle {
  0% { transform: translate(0, 0) scale(0); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1); opacity: 0; }
}

.explode-overlay {
  position: fixed;
  top: 50%;
  left: 50%;
  width: 100vw;
  height: 100vh;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 100;
}

.explode-particle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #6366f1;
  animation: explode-particle 1.2s ease-out forwards;
}

@keyframes avatar-celebrate {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15) rotate(8deg); }
}

.feed-ai-avatar.celebrate { animation: avatar-celebrate 0.8s ease-in-out infinite; }

/* ─── 进度提示动态 (跟 jobpilot .progress-prompt 同结构) ───────────────────────── */
.progress-prompt {
  margin: 16rpx 0;
  padding: 12rpx 20rpx;
  background: #f9f9fb;
  border-left: 6rpx solid #6366f1;
  border-radius: 8rpx;
  text-align: center;
}

.progress-prompt-text {
  font-size: 26rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.progress-prompt-hint {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

/* ─── 完成感弹窗 ───────────────────────── */
.complete-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.complete-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  max-width: 80%;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.16);
}

.complete-emoji { font-size: 80rpx; display: block; margin-bottom: 16rpx; }

.complete-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.complete-subtitle {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
}

.complete-btn {
  padding: 20rpx 40rpx;
  background: #6366f1;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: inline-block;
}

/* ─── 响应式: 小屏字段卡 ───────────────────────── */
@media (max-width: 600rpx) {
  .feed-section-name { font-size: 32rpx; }
  .feed-field-card { width: 260rpx; height: 160rpx; }
  .feed-preview-card { width: 360rpx; }
  .feed-radar { width: 260rpx; }
}