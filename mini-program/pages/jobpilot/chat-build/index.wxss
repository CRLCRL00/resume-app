/* R-JobPilot-v2 W3: 对话建简历样式 (沿用 #6366f1 紫色 + 卡片感) */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
}

/* 顶部:画像标签 + 进度条 */
.header {
  background: #fff;
  padding: 20rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #e5e5e7;
}

.image-badge {
  display: inline-flex;
  align-items: center;
  background: #6366f1;
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(99, 102, 241, 0.3);
}

.badge-icon {
  margin-right: 6rpx;
}

.progress {
  margin-top: 4rpx;
}

.progress-bar {
  height: 6rpx;
  background: #e5e5e7;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  transition: width 0.4s ease-out;
}

.progress-text {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 6rpx;
  text-align: right;
}

/* 对话历史 */
.chat-history {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.message {
  margin-bottom: 24rpx;
  display: flex;
}

.message.assistant {
  justify-content: flex-start;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  display: flex;
  max-width: 80%;
  gap: 12rpx;
}

.assistant-bubble {
  align-items: flex-start;
}

.user-bubble {
  align-items: flex-end;
  flex-direction: row-reverse;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.assistant-avatar {
  background: #6366f1;
  color: #fff;
}

.user-avatar {
  background: #f2f2f7;
  color: #1c1c1e;
}

.content {
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.06);
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-bubble .content {
  background: #6366f1;
  color: #fff;
}

.role-tag {
  font-size: 20rpx;
  color: #8e8e93;
  font-weight: 500;
}

.user-bubble .role-tag {
  color: rgba(255, 255, 255, 0.7);
}

.text {
  font-size: 28rpx;
  color: #1c1c1e;
  line-height: 1.5;
  word-break: break-word;
}

.user-bubble .text {
  color: #fff;
}

.hint {
  font-size: 22rpx;
  color: #6366f1;
  margin-top: 4rpx;
}

.loading-text {
  color: #8e8e93;
}

.dot {
  animation: dotBlink 1.4s infinite;
  display: inline-block;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotBlink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

/* 完成态 */
.completed-banner {
  background: #fff;
  padding: 32rpx;
  border-top: 1rpx solid #e5e5e7;
  max-height: 60vh;
  overflow-y: auto;
}

.completed-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 8rpx;
}

.completed-desc {
  font-size: 24rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 24rpx;
}

.story-points {
  margin-bottom: 24rpx;
}

.story-card {
  background: #f9f9fb;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.story-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6366f1;
  display: block;
  margin-bottom: 8rpx;
}

.story-section {
  font-size: 22rpx;
  color: #3a3a3c;
  line-height: 1.6;
  display: block;
  margin: 4rpx 0;
}

/* 输入区 */
.input-bar {
  background: #fff;
  padding: 16rpx 24rpx 24rpx;
  border-top: 1rpx solid #e5e5e7;
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
}

.input {
  flex: 1;
  min-height: 56rpx;
  max-height: 240rpx;
  padding: 14rpx 20rpx;
  background: #f5f5f7;
  border: 1rpx solid #e5e5e7;
  border-radius: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-send {
  background: #6366f1;
  color: #fff;
  border-radius: 24rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.btn-send[disabled] {
  background: #c7c7cc;
  color: #f5f5f7;
}

/* 启动态 */
.start-screen {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.start-card {
  background: #fff;
  padding: 48rpx 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
  width: 100%;
  max-width: 600rpx;
}

.start-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
}

.start-desc {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
  line-height: 1.6;
}

.image-picker {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.image-option {
  background: #f5f5f7;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.image-option.selected {
  background: #eef2ff;
  border-color: #6366f1;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.15);
}

.opt-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 6rpx;
}

.opt-name {
  font-size: 22rpx;
  color: #1c1c1e;
  display: block;
}

/* 通用按钮 */
.btn-primary {
  width: 100%;
  background: #6366f1;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25);
}

.btn-primary[disabled] {
  background: #c7c7cc;
  color: #f5f5f7;
  box-shadow: none;
}