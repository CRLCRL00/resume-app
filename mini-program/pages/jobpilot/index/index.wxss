/* R-JobSearch 重构 v2: AI 实习求职助手样式 (优化版) */

.jobpilot-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 40rpx;
}

/* R-JobPilot-v2 W3: 对话建简历入口 banner */
.chat-build-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  padding: 28rpx 32rpx;
  margin: 24rpx 32rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.25);
  transition: transform 0.15s, box-shadow 0.2s;
  animation: entryPulse 2s ease-in-out infinite;
}

.chat-build-entry:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.3);
}

.entry-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.entry-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.entry-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 16rpx;
}

@keyframes entryPulse {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.25); }
  50% { box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.4); }
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  color: #8e8e93;
  font-size: 22rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.tab.active {
  color: #6366f1;
  border-bottom-color: #6366f1;
}

.tab.completed {
  background: #f0f9f4;
}

.tab-check {
  position: absolute;
  top: 6rpx;
  right: 16rpx;
  font-size: 22rpx;
  color: #1f7a1f;
  font-weight: bold;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-name {
  /* R139: 22rpx → 24rpx (跟首页 industry-name 32rpx / 卡片 28rpx 视觉更一致) */
  font-size: 24rpx;
}

/* 进度条 */
.progress-bar {
  position: relative;
  height: 8rpx;
  background: #e5e5e7;
  margin: 0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #1f7a1f);
  transition: width 0.3s;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
  padding: 12rpx;
  background: #fafafa;
}

.step-content {
  padding: 40rpx 32rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 12rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #1c1c1e;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.input, .textarea, .picker {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
}

.picker {
  color: #1c1c1e;
}

.resume-id-display {
  background: #f9f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #3a3a3c;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hint {
  font-size: 22rpx;
  color: #ff9500;
}

.btn-primary {
  width: 100%;
  background: #6366f1;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  margin-top: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #c7c7cc;
  color: #f5f5f7;
}

.btn-secondary {
  background: #f2f2f7;
  color: #6366f1;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  margin-top: 16rpx;
}

.result {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1c1c1e;
}

.result-row {
  font-size: 26rpx;
  color: #3a3a3c;
  margin: 6rpx 0;
  line-height: 1.5;
}

.result-sub {
  font-size: 26rpx;
  font-weight: 500;
  margin: 16rpx 0 8rpx;
  color: #6366f1;
}

.bullet {
  font-size: 24rpx;
  color: #3a3a3c;
  padding: 4rpx 0;
  line-height: 1.5;
}

.recommend-jobs,
.strengths,
.avoid-jobs,
.improvements,
.story-preview,
.best-for,
.breakdown,
.resume-section {
  margin-top: 16rpx;
}

.breakdown-row {
  font-size: 24rpx;
  color: #3a3a3c;
  padding: 4rpx 0;
}

.salary-impact {
  font-size: 26rpx;
  color: #1f7a1f;
  font-weight: 500;
  margin-top: 16rpx;
  padding: 12rpx;
  background: #f0f9f4;
  border-radius: 8rpx;
}

.job-chip {
  display: inline-block;
  background: #f2f2f7;
  color: #6366f1;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin: 8rpx 8rpx 0 0;
}

.match-results {
  margin-top: 32rpx;
}

.match-card {
  background: #ffffff;
  border: 1rpx solid #e5e5e7;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.15s, box-shadow 0.2s, border-color 0.2s;
  animation: matchCardIn 0.3s ease-out backwards;
}

/* 错位入场 */
.match-card:nth-child(1) { animation-delay: 0.05s; }
.match-card:nth-child(2) { animation-delay: 0.10s; }
.match-card:nth-child(3) { animation-delay: 0.15s; }
.match-card:nth-child(4) { animation-delay: 0.20s; }
.match-card:nth-child(5) { animation-delay: 0.25s; }

@keyframes matchCardIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.match-card:active {
  transform: scale(0.99);
  background: #f9f9fb;
  border-color: #6366f1;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.12);
}

.match-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.match-company {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.match-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.match-score {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(99, 102, 241, 0.3);
}

.match-verify {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
}

.match-verify.verified {
  background: #d1f4d1;
  color: #1f7a1f;
}

.match-verify.stale {
  background: #fef3c7;
  color: #92400e;
}

.match-verify.unverified {
  background: #f2f2f7;
  color: #8e8e93;
}

.match-salary {
  font-size: 22rpx;
  color: #8e8e93;
}

.match-reason {
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.story-points {
  margin: 16rpx 0;
}

.story-card {
  background: #f9f9fb;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.story-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #6366f1;
}

.story-section {
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.6;
  margin: 6rpx 0;
}

.resume-preview {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f9f9fb;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1c1c1e;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 600rpx;
  overflow-y: auto;
}

.applications {
  margin-top: 16rpx;
}

.app-card {
  background: #ffffff;
  border: 1rpx solid #e5e5e7;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.15s, box-shadow 0.2s, border-color 0.2s;
  animation: appCardIn 0.3s ease-out backwards;
}

.app-card:nth-child(1) { animation-delay: 0.05s; }
.app-card:nth-child(2) { animation-delay: 0.10s; }
.app-card:nth-child(3) { animation-delay: 0.15s; }
.app-card:nth-child(4) { animation-delay: 0.20s; }
.app-card:nth-child(5) { animation-delay: 0.25s; }

@keyframes appCardIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.app-card:active {
  transform: scale(0.99);
  background: #f9f9fb;
  border-color: #6366f1;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.12);
}

.app-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.app-company {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.app-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.app-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
}

.app-status.submitted {
  background: #dbeafe;
  color: #1e40af;
}

.app-status.viewed {
  background: #e0e7ff;
  color: #4338ca;
}

.app-status.interview_scheduled {
  background: #d1f4d1;
  color: #1f7a1f;
}

.app-status.offered {
  background: #fef3c7;
  color: #92400e;
}

.app-status.rejected {
  background: #fee2e2;
  color: #991b1b;
}

.app-status.withdrawn {
  background: #e5e5e7;
  color: #636366;
}

.app-followup {
  font-size: 22rpx;
  color: #ff9500;
  font-weight: 500;
}

.app-note {
  font-size: 24rpx;
  color: #3a3a3c;
  background: #f9f9fb;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.app-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.app-buttons button {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #8e8e93;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ========== R140: A 顶部 tabs + 进度条 + 完成态 polish ========== */

/* A1: sticky tabs 滚动阴影 (滚动时显示更明显边界) */
.tabs {
  box-shadow: 0 1rpx 0 rgba(15, 23, 42, 0.04);
  transition: box-shadow 0.2s;
}

/* A2: tab.active 紫光晕 + checkmark 缩放 (完成态视觉强化) */
.tab.active {
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.15);
}

.tab-check {
  animation: checkPop 0.3s ease-out;
}

@keyframes checkPop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* A3: 进度条 fill pulsing + 平滑过渡 */
.progress-fill {
  position: relative;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 40rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  animation: fillShine 1.5s ease-in-out infinite;
}

@keyframes fillShine {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* A4: 进度文字加完成 emoji (达成感) */
.progress-text {
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* A5: 切换 step 时整 step-content 淡入 */
.step-content {
  animation: stepIn 0.35s ease-out;
}

@keyframes stepIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== R140: B Step 1-2 结果展示 polish ========== */

/* B1: result 统一卡片感 (padding + 边框 + 阴影) */
.result {
  background: #ffffff;
  border: 1rpx solid #e5e5e7;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  animation: resultIn 0.4s ease-out;
}

@keyframes resultIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

/* B2: result-sub 左侧 accent bar (紫色块标识小标题) */
.result-sub {
  position: relative;
  padding-left: 20rpx;
  letter-spacing: 0.3rpx;
}

.result-sub::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #6366f1, #8b5cf6);
  border-radius: 3rpx;
}

/* B3: bullet 列表项逐项错位入场 */
.bullet {
  animation: bulletIn 0.3s ease-out backwards;
}

.bullet:nth-child(1) { animation-delay: 0.05s; }
.bullet:nth-child(2) { animation-delay: 0.10s; }
.bullet:nth-child(3) { animation-delay: 0.15s; }
.bullet:nth-child(4) { animation-delay: 0.20s; }
.bullet:nth-child(5) { animation-delay: 0.25s; }

@keyframes bulletIn {
  from { opacity: 0; transform: translateX(-8rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* B4: story-card 错位入场 + active 反馈 */
.story-card {
  border: 1rpx solid transparent;
  transition: transform 0.15s, box-shadow 0.2s, border-color 0.2s;
  animation: storyIn 0.35s ease-out backwards;
}

.story-card:nth-child(1) { animation-delay: 0.05s; }
.story-card:nth-child(2) { animation-delay: 0.12s; }
.story-card:nth-child(3) { animation-delay: 0.19s; }
.story-card:nth-child(4) { animation-delay: 0.26s; }
.story-card:nth-child(5) { animation-delay: 0.33s; }

@keyframes storyIn {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.story-card:active {
  transform: scale(0.99);
  border-color: #6366f1;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.12);
}

/* B5: breakdown-row 进度条化 (左 label + 右 score + 背景条) */
.breakdown-row {
  position: relative;
  padding: 10rpx 16rpx;
  background: #f9f9fb;
  border-radius: 8rpx;
  margin: 6rpx 0;
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.breakdown-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--score-pct, 0%);
  background: linear-gradient(90deg, rgba(99, 102, 241, 0.08), rgba(139, 92, 246, 0.04));
  z-index: 0;
  transition: width 0.5s ease-out;
}
/* 删除 .breakdown-row > * { z-index: 1 } — WXSS 不支持 '> *' 组合 selector,
   但 children 默认就在 ::before 之上（绘制顺序: background → ::before → content） */

/* B6: job-chip active 反馈 */
.job-chip {
  transition: transform 0.15s, background 0.2s, color 0.2s;
}

.job-chip:active {
  transform: scale(0.96);
  background: #6366f1;
  color: #ffffff;
}

/* B7: result-title 加强 (完成态更突出) */
.result-title {
  letter-spacing: 0.5rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f2f2f7;
}

/* ========== R140: C Step 4 简历预览 polish ========== */

/* C1: resume-preview markdown 渲染美化 */
.resume-preview {
  border: 1rpx solid #e5e5e7;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  font-size: 26rpx;
  line-height: 1.7;
}

.resume-preview h1,
.resume-preview h2,
.resume-preview h3 {
  color: #1c1c1e;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}

.resume-preview h1 { font-size: 32rpx; }
.resume-preview h2 { font-size: 28rpx; }
.resume-preview h3 { font-size: 26rpx; }

.resume-preview ul,
.resume-preview ol {
  padding-left: 32rpx;
  margin: 8rpx 0;
}

.resume-preview li {
  margin: 4rpx 0;
}

.resume-preview code {
  background: #f2f2f7;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #6366f1;
}

.resume-preview pre {
  background: #f2f2f7;
  padding: 16rpx;
  border-radius: 8rpx;
  overflow-x: auto;
}

.resume-preview strong {
  color: #1c1c1e;
  font-weight: 600;
}

/* C2: story-points sticky 顶部 (用户滚动 resume 时 STAR 点保持可见) */
.story-points {
  position: sticky;
  top: 0;
  z-index: 5;
  background: #f5f5f7;
  padding: 16rpx 0;
}

/* C3: copy-md-btn 复制反馈 (active 时变绿) */
.copy-md-btn {
  transition: background 0.2s, color 0.2s, transform 0.1s;
}

.copy-md-btn.copied {
  background: #1f7a1f !important;
  color: #ffffff !important;
}

.copy-md-btn:active {
  transform: scale(0.96);
}

/* C4: resume-section sticky header (resume preview 顶部标题 sticky) */
.resume-section {
  position: relative;
}

.resume-section .result-sub {
  position: sticky;
  top: 16rpx;
  z-index: 4;
  background: rgba(245, 245, 247, 0.92);
  backdrop-filter: blur(8rpx);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

/* salary-impact 加左 accent (B 一致性) */
.salary-impact {
  position: relative;
  padding-left: 24rpx;
  border-left: 6rpx solid #1f7a1f;
}

.salary-impact::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #1f7a1f, #10b981);
}