/* R-JobSearch 重构 v2: AI 实习求职助手样式 (优化版) */

.jobpilot-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  color: #8e8e93;
  font-size: 22rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.tab.active {
  color: #6366f1;
  border-bottom-color: #6366f1;
}

.tab.completed {
  background: #f0f9f4;
}

.tab-check {
  position: absolute;
  top: 6rpx;
  right: 16rpx;
  font-size: 22rpx;
  color: #1f7a1f;
  font-weight: bold;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-name {
  font-size: 22rpx;
}

/* 进度条 */
.progress-bar {
  position: relative;
  height: 8rpx;
  background: #e5e5e7;
  margin: 0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #1f7a1f);
  transition: width 0.3s;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
  padding: 12rpx;
  background: #fafafa;
}

.step-content {
  padding: 40rpx 32rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 12rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #1c1c1e;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.input, .textarea, .picker {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e5e5e7;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
}

.picker {
  color: #1c1c1e;
}

.resume-id-display {
  background: #f9f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #3a3a3c;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hint {
  font-size: 22rpx;
  color: #ff9500;
}

.btn-primary {
  width: 100%;
  background: #6366f1;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  margin-top: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #c7c7cc;
  color: #f5f5f7;
}

.btn-secondary {
  background: #f2f2f7;
  color: #6366f1;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  margin-top: 16rpx;
}

.result {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1c1c1e;
}

.result-row {
  font-size: 26rpx;
  color: #3a3a3c;
  margin: 6rpx 0;
  line-height: 1.5;
}

.result-sub {
  font-size: 26rpx;
  font-weight: 500;
  margin: 16rpx 0 8rpx;
  color: #6366f1;
}

.bullet {
  font-size: 24rpx;
  color: #3a3a3c;
  padding: 4rpx 0;
  line-height: 1.5;
}

.recommend-jobs,
.strengths,
.avoid-jobs,
.improvements,
.story-preview,
.best-for,
.breakdown,
.resume-section {
  margin-top: 16rpx;
}

.breakdown-row {
  font-size: 24rpx;
  color: #3a3a3c;
  padding: 4rpx 0;
}

.salary-impact {
  font-size: 26rpx;
  color: #1f7a1f;
  font-weight: 500;
  margin-top: 16rpx;
  padding: 12rpx;
  background: #f0f9f4;
  border-radius: 8rpx;
}

.job-chip {
  display: inline-block;
  background: #f2f2f7;
  color: #6366f1;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin: 8rpx 8rpx 0 0;
}

.match-results {
  margin-top: 32rpx;
}

.match-card {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.match-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
}

.match-company {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.match-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.match-score {
  background: #6366f1;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.match-verify {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
}

.match-verify.verified {
  background: #d1f4d1;
  color: #1f7a1f;
}

.match-verify.stale {
  background: #fef3c7;
  color: #92400e;
}

.match-verify.unverified {
  background: #f2f2f7;
  color: #8e8e93;
}

.match-salary {
  font-size: 22rpx;
  color: #8e8e93;
}

.match-reason {
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.story-points {
  margin: 16rpx 0;
}

.story-card {
  background: #f9f9fb;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.story-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #6366f1;
}

.story-section {
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.6;
  margin: 6rpx 0;
}

.resume-preview {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f9f9fb;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1c1c1e;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 600rpx;
  overflow-y: auto;
}

.applications {
  margin-top: 16rpx;
}

.app-card {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.app-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
}

.app-company {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.app-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.app-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
}

.app-status.submitted {
  background: #dbeafe;
  color: #1e40af;
}

.app-status.viewed {
  background: #e0e7ff;
  color: #4338ca;
}

.app-status.interview_scheduled {
  background: #d1f4d1;
  color: #1f7a1f;
}

.app-status.offered {
  background: #fef3c7;
  color: #92400e;
}

.app-status.rejected {
  background: #fee2e2;
  color: #991b1b;
}

.app-status.withdrawn {
  background: #e5e5e7;
  color: #636366;
}

.app-followup {
  font-size: 22rpx;
  color: #ff9500;
  font-weight: 500;
}

.app-note {
  font-size: 24rpx;
  color: #3a3a3c;
  background: #f9f9fb;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.app-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.app-buttons button {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #8e8e93;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}